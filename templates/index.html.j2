{%- macro pct(x, d=2) -%}
{%- if x is none -%}—{%- else -%}<span class="{{ 'up' if x > 0 else 'down' if x < 0 else '' }}">{{ "%+.*f"|format(d, x) }}%</span>{%- endif -%}
{%- endmacro -%}
{%- macro num(x, d=2) -%}{%- if x is none -%}—{%- else -%}{{ "{:,.{}f}".format(x, d) }}{%- endif -%}{%- endmacro -%}
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>纳指与波动率日报 · {{ asof }}</title>
<style>
  :root {
    --bg: #f5f6f8; --card: #fff; --text: #1f2329; --muted: #6b7280; --border: #e5e7eb;
    --up: #e03131; --down: #2f9e44; --info: #1c7ed6; --warn: #e8890c; --alert: #c2255c;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.7 -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 24px 16px 48px; }
  header h1 { margin: 0; font-size: 22px; }
  header .meta { color: var(--muted); font-size: 13px; margin-top: 4px; }
  .headline { background: var(--card); border: 1px solid var(--border); border-left: 4px solid var(--info);
              border-radius: 8px; padding: 14px 18px; margin: 18px 0; font-size: 16px; }
  .tags span { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 10px;
               background: #eef2ff; color: #3b5bdb; margin-right: 6px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; }
  .card .label { color: var(--muted); font-size: 12px; }
  .card .value { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .card .sub { font-size: 13px; font-variant-numeric: tabular-nums; }
  .up { color: var(--up); } .down { color: var(--down); }
  .panel { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 16px 18px; margin-top: 16px; }
  .panel h2 { font-size: 17px; margin: 0 0 8px; }
  .panel p { margin: 6px 0; }
  .signals { list-style: none; padding: 0; margin: 10px 0 0; }
  .signals li { padding: 6px 10px; border-radius: 6px; margin-top: 6px; font-size: 14px; }
  .signals .info { background: #e7f5ff; color: #1864ab; }
  .signals .warn { background: #fff4e6; color: #a65d00; }
  .signals .alert { background: #fff0f6; color: var(--alert); font-weight: 600; }
  .toolbar { display: flex; gap: 6px; justify-content: flex-end; margin-top: 16px; }
  .toolbar button { border: 1px solid var(--border); background: var(--card); border-radius: 6px;
                    padding: 3px 12px; cursor: pointer; font-size: 13px; }
  .toolbar button.active { background: #1f2329; color: #fff; border-color: #1f2329; }
  .chart { width: 100%; height: 380px; }
  .chart.small { height: 240px; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 820px) { .grid2 { grid-template-columns: 1fr; } .chart { height: 320px; } }
  footer { color: var(--muted); font-size: 12px; margin-top: 24px; }
  footer ul { padding-left: 18px; margin: 4px 0; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>纳斯达克指数与波动率日报</h1>
    <div class="meta">数据日期：{{ asof }}（周{{ weekday }}，美东收盘）· 生成时间：{{ generated }}（北京时间）</div>
  </header>

  <div class="headline">
    <div class="tags"><span>趋势：{{ c.trend_tag }}</span><span>VIX 水平：{{ c.vol_tag }}</span></div>
    {{ c.headline }}
  </div>

  <div class="cards">
    <div class="card"><div class="label">纳斯达克综合指数</div>
      <div class="value">{{ num(m.ixic.close) }}</div><div class="sub">{{ pct(m.ixic.chg_pct) }} · 年初至今 {{ pct(m.ixic.ret_ytd) }}</div></div>
    <div class="card"><div class="label">纳斯达克 100</div>
      <div class="value">{{ num(m.ndx.close) }}</div><div class="sub">{{ pct(m.ndx.chg_pct) }} · 年初至今 {{ pct(m.ndx.ret_ytd) }}</div></div>
    <div class="card"><div class="label">VIX</div>
      <div class="value">{{ num(m.vix.value) }}</div><div class="sub">{{ pct(m.vix.chg_pct, 1) }} · 一年百分位 {{ num(m.vix.pct_1y, 0) }}%</div></div>
    <div class="card"><div class="label">VXN</div>
      <div class="value">{{ num(m.vxn.value) }}</div><div class="sub">{{ pct(m.vxn.chg_pct, 1) }} · 一年百分位 {{ num(m.vxn.pct_1y, 0) }}%</div></div>
    <div class="card"><div class="label">VIX / VIX3M</div>
      <div class="value">{{ num(m.term.ratio, 3) if m.term else "—" }}</div><div class="sub">大于 1 表示期限结构倒挂</div></div>
    <div class="card"><div class="label">纳指 vs VIX 20 日相关系数</div>
      <div class="value">{{ "%+.2f"|format(m.corr.ixic_vix_20d) if m.corr.ixic_vix_20d is not none else "—" }}</div><div class="sub">一年：{{ "%+.2f"|format(m.corr.ixic_vix_1y) if m.corr.ixic_vix_1y is not none else "—" }}</div></div>
  </div>

  {% for sec in c.sections %}
  <section class="panel">
    <h2>{{ sec.title }}</h2>
    {% for p in sec.paragraphs %}<p>{{ p }}</p>{% endfor %}
    {% if sec.signals %}
    <ul class="signals">{% for s in sec.signals %}<li class="{{ s.level }}">{{ s.text }}</li>{% endfor %}</ul>
    {% endif %}
  </section>
  {% endfor %}

  <div class="toolbar" id="range">
    <button data-days="63">3 个月</button><button data-days="126">6 个月</button>
    <button data-days="252" class="active">1 年</button><button data-days="0">全部</button>
  </div>
  <section class="panel"><h2>纳斯达克综合指数与均线</h2><div id="c-ixic" class="chart"></div></section>
  <section class="panel"><h2>VIX、VXN 与 VIX3M</h2><div id="c-vol" class="chart"></div></section>
  <div class="grid2">
    <section class="panel"><h2>VIX / VIX3M 期限结构</h2><div id="c-term" class="chart small"></div></section>
    <section class="panel"><h2>纳指与 VIX 的 20 日滚动相关系数</h2><div id="c-corr" class="chart small"></div></section>
  </div>

  <footer>
    <div>数据来源：{% for name, src in sources %}{{ name }}：{{ src }}{% if not loop.last %}；{% endif %}{% endfor %}</div>
    {% if notes %}<ul>{% for n in notes %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}
    <div>分析文字由固定规则根据当日数据生成，只描述当前状态，不预测走势，不构成投资建议。</div>
  </footer>
</div>

<script src="assets/echarts.min.js"></script>
<script>
const D = {{ chart_json|safe }};
const UP = '#e03131', DOWN = '#2f9e44';
const N = D.dates.length;
const charts = [];

function base(extra) {
  return Object.assign({
    animation: false,
    grid: { left: 56, right: 24, top: 36, bottom: 56 },
    tooltip: { trigger: 'axis', axisPointer: { type: 'cross' } },
    legend: { top: 0 },
    xAxis: { type: 'category', data: D.dates, boundaryGap: false },
    dataZoom: [{ type: 'inside' }, { type: 'slider', height: 18, bottom: 8 }],
  }, extra);
}
function line(name, data, opts) {
  return Object.assign({ name, type: 'line', data, showSymbol: false, connectNulls: true, lineStyle: { width: 1.5 } }, opts || {});
}
function make(id, option) {
  const ch = echarts.init(document.getElementById(id));
  ch.setOption(option);
  ch.group = 'all';
  charts.push(ch);
  return ch;
}

const price = D.ohlc
  ? { name: '纳指', type: 'candlestick', data: D.ohlc,
      itemStyle: { color: UP, color0: DOWN, borderColor: UP, borderColor0: DOWN } }
  : line('纳指', D.ixic, { lineStyle: { width: 2 } });
make('c-ixic', base({
  yAxis: { scale: true },
  series: [price, line('MA20', D.ma20), line('MA50', D.ma50), line('MA200', D.ma200)],
}));

const volSeries = [line('VIX', D.vix), line('VXN', D.vxn)];
if (D.vix3m) volSeries.push(line('VIX3M', D.vix3m, { lineStyle: { width: 1.2, type: 'dashed' } }));
make('c-vol', base({ yAxis: { scale: true }, series: volSeries }));

if (D.term) {
  make('c-term', base({
    legend: { show: false }, yAxis: { scale: true },
    series: [line('VIX/VIX3M', D.term, { markLine: { silent: true, symbol: 'none', data: [{ yAxis: 1 }],
      lineStyle: { color: '#c2255c', type: 'dashed' }, label: { position: 'insideEndTop', formatter: '倒挂线 1.0' } } })],
  }));
} else {
  document.getElementById('c-term').innerHTML = '<p style="color:#6b7280">VIX3M 数据缺失。</p>';
}

make('c-corr', base({
  legend: { show: false }, yAxis: { min: -1, max: 1 },
  series: [line('20 日相关系数', D.corr20, { areaStyle: { opacity: 0.08 }, markLine: { silent: true, symbol: 'none',
    data: [{ yAxis: 0 }], lineStyle: { color: '#6b7280', type: 'dashed' }, label: { show: false } } })],
}));

echarts.connect('all');

function setRange(days) {
  const startValue = days > 0 ? Math.max(0, N - days) : 0;
  charts.forEach(ch => ch.dispatchAction({ type: 'dataZoom', startValue, endValue: N - 1 }));
}
document.getElementById('range').addEventListener('click', e => {
  const b = e.target.closest('button');
  if (!b) return;
  document.querySelectorAll('#range button').forEach(x => x.classList.toggle('active', x === b));
  setRange(Number(b.dataset.days));
});
setRange(252);
window.addEventListener('resize', () => charts.forEach(ch => ch.resize()));
</script>
</body>
</html>
